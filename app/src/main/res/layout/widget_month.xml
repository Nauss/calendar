<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_surface_light">
    <include layout="@layout/widget_header"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
        <ImageButton android:id="@+id/widget_previous" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@drawable/widget_previous" android:padding="12dp" android:contentDescription="@string/previous"/>
        <TextView android:id="@+id/widget_month_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <ImageButton android:id="@+id/widget_today" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@drawable/widget_today" android:padding="12dp" android:contentDescription="@string/today"/>
        <ImageButton android:id="@+id/widget_next" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@drawable/widget_next" android:padding="12dp" android:contentDescription="@string/next"/>
    </LinearLayout>
    <ListView android:id="@+id/widget_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="0dp"/>
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:text="@string/widget_loading" android:textSize="12sp" android:maxLines="3" android:ellipsize="end"/>
</LinearLayout>